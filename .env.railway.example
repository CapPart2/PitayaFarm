# Add these as Railway Variables. Do not commit the real values.
ADMIN_TOKEN=replace-with-a-long-random-secret
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set to 1 for one deployment only to reset the existing admin password, then remove it.
PITAYA_RESET_ADMIN_PASSWORD=0
PITAYA_DATA_DIR=/app/data
