# PITAYA Backend - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database Configuration
# For production, use PostgreSQL or MySQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost/pitaya_db
# DATABASE_URL=mysql://user:password@localhost/pitaya_db

# Dashboard API Configuration
DASHBOARD_API_URL=http://localhost:5001

# Model Configuration
MODEL_PATH=leaf_disease_model.keras

# Logging
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=*
